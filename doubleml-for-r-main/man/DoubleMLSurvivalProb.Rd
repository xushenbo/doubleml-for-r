ml_g_cens <- "survSL.km"  # For censoring functions
ml_m <- "SL.glm"          # For propensity score

# Create and fit model
dml_surv_prob <- DoubleMLSurvivalProb$new(
  obj_dml_data,
  ml_g_surv,
  ml_g_cens,
  ml_m,
  admin_cens = 5
)
dml_surv_prob$fit()
dml_surv_prob$summary()
}
